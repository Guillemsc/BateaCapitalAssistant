{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "openai"
  ],
  "permission": {
    "*": "deny",
    "batea_*": "allow",
    "websearch": "allow",
    "webfetch": "allow"
  },
  "mcp": {
    "batea": {
      "type": "remote",
      "url": "http://127.0.0.1:4197/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:BATEA_MCP_TOKEN}"
      }
    }
  },
  "model": "openai/gpt-6-luna",
  "default_agent": "telegram",
  "agent": {
    "telegram": {
      "mode": "primary",
      "model": "openai/gpt-6-luna",
      "variant": "high",
      "options": {
        "reasoningEffort": "high"
      }
    }
  }
}
